# Discord ──────────────────────────────────────────────────────────────────
# URL webhook channel Discord Anda (Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Interval (dalam detik) ───────────────────────────────────────────────────
# Seberapa sering log teks dikirim ke Discord
LOG_INTERVAL=60

# Seberapa sering screenshot diambil dan dikirim ke Discord
SCREENSHOT_INTERVAL=120

# Enkripsi Cache Lokal ─────────────────────────────────────────────────────
# Key Fernet untuk mengenkripsi cache offline. Generate dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Jika dikosongkan, cache lokal tidak dienkripsi.
FERNET_KEY=
